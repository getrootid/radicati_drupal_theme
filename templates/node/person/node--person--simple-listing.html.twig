{% extends "node.html.twig" %}

{% block content_wrapper %}
  {% embed "radicati_drupal_theme:person-listing-simple-card" with {
    content_attributes: content_attributes,
    person_full_name: content.field_person_first_name.0|render ~ ' ' ~ content.field_person_last_name.0|render,
    person_pronouns: not node.field_person_pronouns.isEmpty ? content.field_person_pronouns.0 : null,
    person_position: not node.field_person_position.isEmpty ? content.field_person_position.0 : null
  } %}
  {% endembed %}
{% endblock %}