<div id="page" class="full-site-wrapper">
  {{ page.site_notification }}

  {% embed "radicati_drupal_theme:header-two-row" %}
    {% block branding %}{{ page.header_branding }}{% endblock %}
    {% block primary_nav %}{{ page.primary_navigation }}{% endblock %}
    {% block secondary_nav %}{{ page.secondary_navigation }}{% endblock %}
    {% block search_dropdown %}{{ page.search }}{% endblock %}
  {% endembed %}

  {% embed "radicati_drupal_theme:off-canvas" with {

  } %}
    {% block header %} {{ page.off_canvas_header }} {% endblock %}
    {% block content %} {{ page.off_canvas }} {% endblock %}
    {% block footer %} {{ page.off_canvas_footer }} {% endblock %}
  {% endembed %}

  {% block hero %}
    {{ page.hero }}
  {% endblock hero %}

  <div class="all-content-wrapper">
    {% block inline_menu %}
      {{ page.inline_menu }}
    {% endblock %}

    {% block breadcrumb %}
      {{ page.breadcrumb }}
    {% endblock breadcrumb %}

    {{ page.system_help }}

    <main>
      <a id="main-content"></a>
      {% block pre_content %}
        {{ page.pre_content }}
      {% endblock pre_content %}

      {% block page_title %}
        {{ page.page_title }}
      {% endblock %}

      {% block page_content %}
        <div id="main-page-content" class="page-content content-container--normal">
          {% block content %}
            {{ page.content }}
          {% endblock %}

          {% block sidebar_one %}
            {{ page.sidebar_one }}
          {% endblock %}

          {% block sidebar_two %}
            {{ page.sidebar_two }}
          {% endblock %}
        </div>
      {% endblock page_content %}

      {% block post_content %}
        {{ page.post_content }}
      {% endblock post_content %}
    </main>
  </div>

  {% embed "radicati_drupal_theme:footer-large" %}
    {% block column_one %}{{ page.footer_one }}{% endblock %}
    {% block column_two %}{{ page.footer_two }}{% endblock %}
    {% block column_three %}{{ page.footer_three }}{% endblock %}
    {% block copyright %}{{ page.copyright }}{% endblock %}
  {% endembed %}
  <div class='off-canvas__overlay oc-overlay'></div>
</div>
