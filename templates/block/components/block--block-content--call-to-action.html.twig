{% extends "block--block-content.html.twig" %}

{% block content %}
  {% block outer_content %}
    {% embed "radicati_drupal_theme:call-to-action" with {
      content_attributes: content_attributes,
      title: content.field_component_title.0|render,
      blurb: content.field_component_blurb.0|render,
      label: content.field_cta_label.0|render,
      subtitle: content.field_component_sub_title.0|render,
      alignment: content.field_setting_alignment|render,
      style: content.field_setting_style|render,
    } %}
      {% block media %}
        {{ content.field_component_media }}
      {% endblock %}

      {% block actions %}
        {{ content.field_component_read_more }}
      {% endblock %}
    {% endembed %}
  {% endblock %}
{% endblock %}

