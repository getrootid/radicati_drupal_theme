{% extends "block--block-content.html.twig" %}

{% block outer_content %}
  {% embed "radicati_drupal_theme:highlight" with {
    content_attributes: content_attributes.addClass('highlight'),
    title: content.field_component_title.0,
    blurb: content.field_component_blurb,
    alignment: content.field_setting_alignment|render,
    style: content.field_setting_style|render,
    layout: content.field_setting_layout|render,
  } %}
    {% block media %}
      {{ content.field_component_media }}
    {% endblock %}

    {% block actions %}
      {{ content.field_component_read_more }}
    {% endblock %}
  {% endembed %}
{% endblock %}

