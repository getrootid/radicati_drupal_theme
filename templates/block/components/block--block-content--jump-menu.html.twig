{% extends "block--block-content.html.twig" %}

{% block content %}
  {% set items = [] %}

  {% for key, item in content.field_jump_menu_items %}
    {% if key|first != '#' %}
      {% set items = items|merge([ {
        label: item['#paragraph'].field_jmi_label.0.value,
        anchor: item['#paragraph'].field_jmi_content_id.0.value
      } ]) %}
    {% endif %}
  {% endfor %}
  {% embed "radicati_drupal_theme:jump-menu" with {
    content_attributes: content_attributes,
    label: content.field_jump_menu_label,
    items: items
  } %}
  {% endembed %}
{% endblock %}