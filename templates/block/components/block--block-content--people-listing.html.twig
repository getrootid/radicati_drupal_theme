{% extends "block--block-content.html.twig" %}

{% block outer_content %}
  {% embed "radicati_drupal_theme:people-listing" with {
    content_attributes: content_attributes,
    title: content.field_component_title,
    subtitle: content.field_component_sub_title,
    style: content.field_setting_style|render,
  } %}
    {% block detail_items %}{{ content.field_people_listing_details }}{% endblock %}
    {% block simple_items %}{{ content.field_people_listing_simple }}{% endblock %}
  {% endembed %}
{% endblock %}

