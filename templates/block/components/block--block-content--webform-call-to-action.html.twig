{% extends "block--block-content.html.twig" %}

{% block outer_content %}
  {% embed "radicati_drupal_theme:webform-cta" with {
    content_attributes: content_attributes,
    title: content.field_component_title.0,
    blurb: content.field_component_blurb.0,
    background_image: content.field_component_background_media|render,
  } %}
    {% block form %}
      {{ content.field_webform_cta_form }}
    {% endblock %}
  {% endembed %}
{% endblock %}

