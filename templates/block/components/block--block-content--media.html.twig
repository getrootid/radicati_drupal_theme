{% extends "block--block-content.html.twig" %}

{% block outer_content %}
  {% embed "radicati_drupal_theme:media" with {
    content_attributes: content_attributes,
    display_mode: content.field_setting_media_display_mode|render|striptags|trim|clean_class
  } %}
    {% block media %}
      {{ content.field_media__media_item }}
    {% endblock %}
  {% endembed %}
{% endblock %}

