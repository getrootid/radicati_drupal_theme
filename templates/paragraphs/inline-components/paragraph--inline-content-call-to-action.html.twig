{% extends "paragraph.html.twig" %}

{% block content %}
  {% embed "radicati_drupal_theme:content-cta" with {
    content_attributes: content_attributes
  } %}
    {% block title %}
      {{ content.field_icta_title }}
    {% endblock %}

    {% block body %}
