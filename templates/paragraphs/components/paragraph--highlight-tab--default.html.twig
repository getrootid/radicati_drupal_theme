{% extends "paragraph.html.twig" %}

{% block paragraph %}
  {% embed "radicati_drupal_theme:highlight-tab" with {
    content_attributes: content_attributes,
    title: content.field_card_title,
    blurb: content.field_card_blurb,
  } %}
    {% block media %}
      {{ content.field_card_media }}
    {% endblock %}

    {% block actions %}
      {{ content.field_card_link }}
    {% endblock %}
  {% endembed %}
{% endblock %}