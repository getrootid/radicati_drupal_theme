{% extends "paragraph.html.twig" %}

{% block content %}
  {#  Get value of field_accordion_start_open to see if it should start out open  #}
  {% set start_open = paragraph.field_accordion_start_open.value == "1" %}

  {% embed "radicati_drupal_theme:accordion-item" with {
    start_open: start_open,
    title: content.field_accordion_title
  }%}
    {% block body %}
      {{ content.field_accordion_content }}
    {% endblock %}
  {% endembed %}
{% endblock %}