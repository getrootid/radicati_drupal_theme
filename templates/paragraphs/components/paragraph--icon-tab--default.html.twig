{% extends "paragraph.html.twig" %}

{% block content %}
  {% embed "radicati_drupal_theme:tab-panel" with {
    content_attributes: content_attributes,
    label: paragraph.field_icon_tab__label.0.value,
    icon: content.field_icon_tab__icon
  } %}
    {% block tab_content %}
      {{ content|without('field_icon_tab__label', 'field_icon_tab__icon') }}
    {% endblock %}
  {% endembed %}
{% endblock %}