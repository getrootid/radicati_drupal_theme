{% extends "paragraph.html.twig" %}

{% block paragraph %}
  {% embed "radicati_drupal_theme:media" with {
    content_attributes: content_attributes
  } %}

    {% block media %}
      {{ content.field_media_item__media }}
    {% endblock %}

    {% block caption %}
      {{ content|without('field_media_item__media') }}
    {% endblock %}
  {% endembed %}
{% endblock %}