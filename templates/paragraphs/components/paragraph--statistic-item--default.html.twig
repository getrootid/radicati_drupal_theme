{% extends "paragraph.html.twig" %}

{% block paragraph %}
  {% embed "radicati_drupal_theme:stat-card" with {
    content_attributes: content_attributes,
    stat_value: content.field_stat_value,
    stat_label: content.field_stat_label
  } %}

    {% block media %}
      {% if not paragraph.field_stat_icon.isEmpty() %}
        {{ content.field_stat_icon }}
      {% endif %}
    {% endblock %}
  {% endembed %}
{% endblock %}