{% set classes = [
  'component',
  'component--layout--region',
  'region',
  region_style,
  outer_width,
  inner_width
] %}
<section class="{{ classes|join(' ') }}">
  <div class="region__inner">
    {% block region %}
      {{ content }}
    {% endblock %}
  </div>
  {% if region_style == 'component--style--pink' %}
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
    <div class="firefly"></div>
  {% endif %}
</section>