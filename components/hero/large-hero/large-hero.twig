{% set classes = [
  'component',
  'component--section',
  'large-hero',
] %}
{# if content attributes isn't set, use create_attriburte() #}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="large-hero__media background-media slot slot--background-media">
    {% block media %}Media Content{% endblock %}
  </div>

  <div class="large-hero__content">
    <h1 class="large-hero__title">{{ title }}</h1>
    <div class="large-hero__blurb">{{ blurb }}</div>

    {% if block('actions') is defined and block('actions')|trim is not empty %}
      <div class="large-hero__actions slot slot--readmore">
        {% block actions %}{% endblock %}
      </div>
    {% endif %}
  </div>
</section>