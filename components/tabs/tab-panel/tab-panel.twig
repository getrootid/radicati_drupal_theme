{% set panel_id = label|clean_unique_id %}

<div id="{{ panel_id ~ "--tab-container" }}" class="tab__label" data-tab="{{ panel_id }}">
  <div class="tab__label__text">
    {{ label }}
  </div>
  {% if icon|render|trim %}
    <div class="tab__label__icon">
      {{ icon|raw }}
    </div>
  {% endif %}
</div>

<div id="{{ panel_id }}"
     aria-labelledby="{{ panel_id ~ "--tab" }}"
     class="tab__panel"
     role="tabpanel">
  {% block tab_content %}{% endblock %}
</div>