{% set classes = [
  'component',
  'component--section',
  'form-section',
] %}

{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="form-section__content">
    {% block body %}Default Content{% endblock %}
  </div>
</section>