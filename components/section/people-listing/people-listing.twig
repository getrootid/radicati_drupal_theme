{% set classes = [
  'component',
  'component--section',
  'people-listing',
  style
] %}

{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="people-listing__inner component--inner">
      <div class="people-listing__header">
        {% if title %}
          <h2 class="people-listing component--title">
            {{ title }}
          </h2>
        {% endif %}

        {% if subtitle %}
          <p class="people-listing__sub-title component--sub-title">
            {{ subtitle }}
          </p>
        {% endif %}
      </div>

    {% if block('detail_items') is defined and block('detail_items')|trim is not empty %}
      <div class="people-listing__detail-items">
        {% block detail_items %}{% endblock %}
      </div>
    {% endif %}

    {% if block('simple_items') is defined and block('simple_items')|trim is not empty %}
      <div class="people-listing__simple-items">
        {% block simple_items %}{% endblock %}
      </div>
    {% endif %}
  </div>
</section>