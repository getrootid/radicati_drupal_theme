{% set classes = [
  'component',
  'component--section',
  'media-carousel',
  style,
] %}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="media-carousel__inner component--inner">
    <div class="media-carousel__content">
      <h2 class="media-carousel__title component--title">
        {{ title }}
      </h2>

      <p class="media-carousel__sub-title component--sub-title">
        {{ subtitle }}
      </p>
    </div>

    {% if block('items') is defined and block('items')|trim is not empty %}
      {% set items_r = block('items') %}

      <div class="media-carousel__carousel-wrapper slot slot--items">
        {% if display_carousel %}
          {% embed "radicati_drupal_theme:carousel" with {
            title: "Media Carousel",
            slides_per_page_desktop: 1,
            slides_per_page_tablet: 1,
            slides_per_page_default: 1,
            arrows: true,
            pagination: false,
            loop: false,
            autoplay: false,
            hide_until_active: true
          } %}
            {% block slides %}
              {{ items_r|raw }}
            {% endblock %}
          {% endembed %}
        {% else %}
          <div class="media-carousel__items-editing drop-zone">
            {{ items_r|raw }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="media-carousel__actions slot slot--actions">
      {% block actions %}{% endblock %}
    </div>
  </div>
</section>