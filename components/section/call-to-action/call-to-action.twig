{% set classes = [
  'component',
  'component--section',
  'call-to-action',
  content_position ? content_position : '',
  alignment ?? '',
  style ?? ''
] %}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  {% if block('media') is defined and block('media')|trim is not empty %}

    <div class="call-to-action__media slot slot--media background-media">
      {% block media %}{% endblock %}
  {#    {% if image is iterable %}#}
  {#      {% include "canvas:image" with image|merge({#}
  {#        sizes: '(min-width: calc(982/16 * 1rem)) 50vw, 100vw',#}
  {#        loding: 'lazy',#}
  {#        height: 600#}
  {#      }) only %}#}
  {#    {% else %}#}
  {#      {{ image|render }}#}
  {#    {% endif %}#}
    </div>
  {% endblock %}

  <div class="call-to-action__inner component--inner">
    <div class="call-to-action__content">
      <p class="call-to-action__label">{{ label }}</p>
      <h2 class="call-to-action__title">{{ title }}</h2>
      <p class="call-to-action__sub-title">{{ subtitle }}</p>
      <p class="call-to-action__blurb">{{ blurb }}</p>

      <div class="call-to-action__actions slot slot--actions">
        {% block actions %}{% endblock %}
      </div>
    </div>
  </div>
</section>