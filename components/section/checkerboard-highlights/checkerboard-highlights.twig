{% set classes = [
  'component',
  'component--section',
  'checkerboard-highlights',
  style ?? ''
] %}
<section class="{{ classes|join(' ') }}">
  <div class="checkerboard-highlights__inner component--inner">
    <div class="checkerboard-highlights__items slot slot--items">
      {% block items %}{% endblock %}
    </div>
  </div>
</section>