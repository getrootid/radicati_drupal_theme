{% set classes = [
  'component',
  'component--section',
  'highlight',
  style ?? '',
  alignment ?? '',
  layout ?? ''
] %}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="highlight__inner">
    <div class="highlight__media slot slot--media">
      {% block media %}{% endblock %}
  {#    {% if image is iterable %}#}
  {#      {% include "canvas:image" with image|merge({#}
  {#        sizes: '(min-width: calc(982/16 * 1rem)) 50vw, 100vw',#}
  {#        loding: 'lazy',#}
  {#        height: 600#}
  {#      }) only %}#}
  {#    {% else %}#}
  {#      {{ image|render }}#}
  {#    {% endif %}#}
    </div>

    <div class="highlight__content">
      <h2 class="highlight__title">{{ title }}</h2>
      <div class="highlight__blurb">{{ blurb }}</div>

      <div class="highlight__actions slot slot--actions">
        {% block actions %}{% endblock %}
      </div>
    </div>
  </div>
</section>