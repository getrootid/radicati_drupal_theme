{%
 set classes = [
  'component',
  'component--section',
  'tab-group',
  (tabs_position) ? 'tab-group--tabs-position-' ~ tabs_position: 'tab-group--tabs-no-position'
]
%}

{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}

<section {{ content_attributes.addClass(classes) }}>
  <div class="tab-group__inner component--inner">
    <div class="tab-group__nav__list" role="tablist">

    </div>

    <div class="tab-group__tabs">
      {% block tabs %}{% endblock %}
    </div>
  </div>
</section>