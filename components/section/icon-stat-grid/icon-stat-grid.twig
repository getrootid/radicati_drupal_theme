{% set classes = [
  'component',
  'component--section',
  'icon-stat-grid',
  style ? style,
  items_per_row ? items_per_row,
] %}

{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<section {{ content_attributes.addClass(classes) }}>
  <div class="icon-stat-grid__inner component--inner">

    <div class="icon-stat-grid__header">
      <h2 class="icon-stat-grid__title component--title">{{ title }}</h2>

      {% if subtitle %}
        <p class="icon-stat-grid__sub-title component--sub-title">
          {{ subtitle }}
        </p>
      {% endif %}

      {% if blurb %}
        <p class="icon-stat-grid__blurb component--blurb">{{ blurb }}</p>
      {% endif %}
    </div>

    <div class="icon-stat-grid__cards slot slot--cards">
      {% block cards %}{% endblock %}
    </div>

    {% if block('actions') is defined and block('actions')|trim is not empty %}
      <div class="icon-grid__actions slot slot--actions">
        {% block actions %}{% endblock %}
      </div>
    {% endif %}
  </div>
</section>