<footer class="footer-large">
  <div class="footer-large__top">
    <div class="footer-large__top__inner">
      <div class="footer-large__top__column footer-large__top__column--1">
        {% block column_one %}{% endblock %}
      </div>

      <div class="footer-large__top__column footer-large__top__column--2">
        {% block column_two %}{% endblock %}
      </div>

      <div class="footer-large__top__column footer-large__top__column--3">
        {% block column_three %}{% endblock %}
      </div>
    </div>
  </div>

  <div class="footer-large__copyright">
    {% block copyright %}{% endblock %}
  </div>
</footer>