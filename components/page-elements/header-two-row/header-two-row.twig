<header class="header-two-row" id="site-header">
  <div class="header-two-row__row header-two-row__top-row">
    <div class="header-two-row__row-inner">
      <div class="header-two-row__secondary-nav-wrapper">
        {% block secondary_nav %}test{% endblock %}
      </div>
    </div>

  </div>

  <div class="header-two-row__row header-two-row__bottom-row">
    <div class="header-two-row__row-inner">
      <div class="header-two-row__branding-wrapper">
        {% block branding %}test{% endblock %}
      </div>

      <div class="header-two-row__primary-nav-wrapper">
        {% block primary_nav %}test{% endblock %}
      </div>
    </div>
  </div>

  <div id="search-dropdown" class="header-two-row__search-dropdown">
    {% block search_dropdown %}{% endblock %}
  </div>
</header>