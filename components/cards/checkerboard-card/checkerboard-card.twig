{% set classes = [
  'card',
  'checkerboard-card',
] %}
<div class="{{ classes|join(' ') }}">
    <div class="checkerboard-card__media">
      {% block media %}{% endblock %}
{#      {% if background_image is iterable %}#}
{#        {% include "canvas:image" with background_image|merge({#}
{#          sizes: '100vw',#}
{#          loding: 'eager'#}
{#        }) only %}#}
{#      {% else %}#}
{#        {{ background_image|raw }}#}
{#      {% endif %}#}
    </div>

  <div class="checkerboard-card__content">
    <div class="checkerboard-card__body">
      <h2 class="checkerboard-card__title">{{ title }}</h2>
      <div class="checkerboard-card__blurb">{{ blurb }}</div>
    </div>
    {% if block('actions') is defined and block('actions')|trim is not empty %}
      <div class="checkerboard-card__actions">
        {% block actions %}{% endblock %}
      </div>
    {% endif %}
  </div>
</div>