{% set classes = [
  'card',
  'collection-card'
] %}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<div {{ content_attributes.addClass(classes) }}>
    <div class="collection-card__media slot slot--media">
      {% block media %}{% endblock %}
{#      {% if image is iterable %}#}
{#        {% include "canvas:image" with image|merge({#}
{#          sizes: '100vw, (min-width: calc(768/16 * 1rem)) 33vw',#}
{#          loding: 'lazy'#}
{#        }) only %}#}
{#      {% else %}#}
{#        {{ image|render }}#}
{#      {% endif %}#}
    </div>

  <div class="collection-card__body">
    <h3 class="collection-card__title">
      {% if title_url %}
        <a href="{{ title_url }}" class="collection-card__title-link">{{ title }}</a>
      {% else %}
        {{ title }}
      {% endif %}
    </h3>
    {% if tag  %}
      <div class="collection-card__tag">{{ tag }}</div>
    {% endif %}

    <div class="collection-card__blurb">{{ blurb }}</div>

    {% if block('actions') is defined and block('actions')|trim is not empty %}
      <div class="collection-card__actions slot slot--actions">
        {% block actions %}{% endblock %}
      </div>
    {% endif %}
  </div>
</div>