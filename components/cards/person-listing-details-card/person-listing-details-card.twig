<div{{ content_attributes.addClass('detailed-listing') }}>
  {% if block('media') is defined and block('media')|trim is not empty %}
    <div class="detailed-listing__media">
      {% block media %}{% endblock %}
    </div>
  {% endif %}


  <div class="detailed-listing__content">
    <div class="detailed-listing__name-line">
      <span class="detailed-listing__name">
        {{ person_full_name }}
      </span>
      {% if person_pronouns %}
        <span class="detailed-listing__pronouns">{{ person_pronouns }}</span>
      {% endif %}
    </div>

    {% if person_position %}
      <div class="detailed-listing__position">{{ person_position }}</div>
    {% endif %}

    <div class="details-listing__body">
      {% block body %}{% endblock %}
    </div>
  </div>
</div>