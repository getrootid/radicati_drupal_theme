{% set classes = [
  'card',
  'icon-card',
  'card--no-background'
] %}
{% if content_attributes is not defined %}
  {% set content_attributes = create_attribute() %}
{% endif %}
<div {{ content_attributes.addClass(classes) }}>
  <div class="icon-card__inner card--inner">
    {% if block('media') is defined and block('media')|trim is not empty %}
      {% if link %}
        <a href="{{ link }}" target="{{ link_target }}" class="icon-card__link">
      {% endif %}
      <div class="icon-card__media slot slot--media">
        {% block media %}{% endblock %}
      </div>
      {% if link %}</a>{% endif %}
    {% endif %}

    <div class="icon-card__title card--title">
      {% if link %}
        <a href="{{ link }}" target="{{ link_target }}" class="icon-card__link">
      {% endif %}

      {{ title }}

      {% if link %}
        </a>
      {% endif %}
    </div>

    <p class="icon-card__blurb card--blurb">
      {{ blurb }}
    </p>
  </div>

</div>